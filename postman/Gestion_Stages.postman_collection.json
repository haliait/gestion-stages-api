{
  "info": {
    "name": "API Gestion des Stages",
    "description": "Tests du mini-projet. Changez la variable baseUrl : http://127.0.0.1:8000 en local, ou l'URL Render.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0 - Accueil",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": []
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Statut 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "1 - Créer un stage",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/stages",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "stages"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nom_etudiant\": \"Étudiant Test\",\n  \"entreprise\": \"Entreprise Démo\",\n  \"intitule\": \"Développement d'une API REST\",\n  \"date_debut\": \"2026-02-01\",\n  \"date_fin\": \"2026-07-31\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Statut 201 Created', () => pm.response.to.have.status(201));",
              "const data = pm.response.json();",
              "pm.collectionVariables.set('stageId', data.id);",
              "pm.test('Le stage a un id', () => pm.expect(data.id).to.be.a('number'));"
            ]
          }
        }
      ]
    },
